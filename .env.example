# 从 Dify 的“访问点 → API 密钥”复制。不要提交真实 .env 文件。
DIFY_API_KEY=replace-with-your-dify-api-key
DIFY_API_BASE_URL=https://api.dify.ai/v1
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=1440

# 本地 Docker PostgreSQL。正式环境必须使用独立的强密码。
DATABASE_URL=postgresql://reading_app:local_dev_password_change_me@127.0.0.1:5432/reading_assistant

# 用于加密用户自己的 AI API Key；请生成一个长期保存的 Fernet 密钥。
AI_ENCRYPTION_KEY=replace-with-a-fernet-key
